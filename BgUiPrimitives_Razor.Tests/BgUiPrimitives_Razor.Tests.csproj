<Project Sdk="Microsoft.NET.Sdk">

  <!-- Framework, nullable, implicit usings, and warnings-as-errors are repo-wide
       policy — see ..\Directory.Build.props. Only per-project decisions live here. -->
  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <!-- Opt out of the repo-wide GenerateDocumentationFile: a test assembly ships
         no public API, so a doc file would only invite CS1591 noise on xUnit
         fixtures. Warnings-as-errors still applies (inherited from props). -->
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <!-- Direct reference: this project compiles against AngleSharp.Dom types
         (rationale in Directory.Packages.props). -->
    <PackageReference Include="AngleSharp" />
    <PackageReference Include="bunit" />
    <PackageReference Include="coverlet.collector" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\BgUiPrimitives_Razor\BgUiPrimitives_Razor.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The library's project file, linked (not copied into source control)
         and staged beside the test assembly, so the trim-posture pin reads the
         file the library is actually built from. Moving or renaming it breaks
         this build rather than a test at runtime. -->
    <None Include="..\BgUiPrimitives_Razor\BgUiPrimitives_Razor.csproj"
          Link="TrimPosture\BgUiPrimitives_Razor.csproj" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

</Project>
